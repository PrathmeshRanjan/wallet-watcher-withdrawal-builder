# Required: generate a testnet-only mnemonic with `pnpm setup`.
HD_MNEMONIC=

# Base Sepolia. Replace the public endpoint with a dedicated provider for reliability.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

WALLET_COUNT=3
POLL_INTERVAL_SECONDS=60
DATABASE_PATH=./data/wallet-watcher.db
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Optional. When set, mutating API calls require `Authorization: Bearer <value>`.
ADMIN_API_KEY=

# Optional comma-separated browser origins. Vite's local origin is allowed by default.
CORS_ORIGINS=http://localhost:5173

